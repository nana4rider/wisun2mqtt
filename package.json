    "@eslint/js": "^10.0.1",
    "@serialport/binding-mock": "^10.2.2",
    "@types/node": "^24.10.7",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lefthook": "^2.0.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
